{
  "mcpServers": {
    "bob-marketplace": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:54841/mcp",
      "headers": {
        "Bob-Marketplace-Token": "bob-marketplace-local"
      },
      "disabled": false,
      "alwaysAllow": [
        "search_assets",
        "get_asset",
        "list_installed",
        "list_favorites",
        "suggest_assets",
        "list_updates"
      ]
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "hashicorp/terraform-mcp-server:1.3.0",
        "--toolsets=registry"
      ]
    }
  }
}
